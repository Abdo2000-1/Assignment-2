# Ignore everything by default
*

# Keep only your source files and the .jucer file
!*.cpp
!*.h
!*.jucer

# Keep directories leading to files you want
!*/

# Ignore JUCE modules folder
modules/

# Ignore JUCE auto-generated library code
JuceLibraryCode/

# Ignore build folders
Builds/
bin/
obj/

# Ignore IDE files
.vs/
*.vcxproj*
*.sln*
*.user*
*.opensdf
*.sdf
*.ipch
*.ncb
*.suo
*.log
